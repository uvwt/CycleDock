# 复制为 .env.local；仅供本机开发，不用于部署。
DATABASE_URL=postgres://cycledock:cycledock@127.0.0.1:5432/cycledock?sslmode=disable
CYCLEDOCK_ADMIN_PASSWORD=local-dev-password
HTTP_ADDR=127.0.0.1:8080
DEV_WEB_PORT=5173

# 按需配置，密钥生成方式见 docs/development.md。
CYCLEDOCK_MODEL_API_KEY=
CYCLEDOCK_MODEL_SECRET_KEY=
CYCLEDOCK_CONNECTION_ENCRYPTION_KEY=
