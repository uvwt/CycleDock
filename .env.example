# Self-hosted Human Web：未配置 OIDC 时使用。至少 12 个字符。
CYCLEDOCK_ADMIN_PASSWORD=

# Remote MCP 需要 Public URL；Hosted Human Web 再额外配置 OIDC issuer/client。
CYCLEDOCK_PUBLIC_URL=
CYCLEDOCK_OIDC_ISSUER=
CYCLEDOCK_OIDC_CLIENT_ID=

# 通常无需设置：HTTPS Public URL 会自动启用 Secure Cookie。
# Self-hosted 未配置 Public URL 但由 HTTPS 反代暴露时，可显式设为 true。
CYCLEDOCK_SECURE_COOKIE=

# Built-in Cycle Agent secret values。Settings 页面只保存下面这些变量的“名称”，
# 不会把 secret 明文写进 PostgreSQL。
CYCLEDOCK_MODEL_API_KEY=
CYCLEDOCK_MCP_TOKEN=
