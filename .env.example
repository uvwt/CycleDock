# Self-hosted Human Web：未配置 OIDC 时使用。至少 12 个字符。
CYCLEDOCK_ADMIN_PASSWORD=

# Remote MCP 需要 Public URL；Hosted Human Web 再额外配置 OIDC issuer/client。
CYCLEDOCK_PUBLIC_URL=
CYCLEDOCK_OIDC_ISSUER=
CYCLEDOCK_OIDC_CLIENT_ID=

# 通常无需设置：HTTPS Public URL 会自动启用 Secure Cookie。
# Self-hosted 未配置 Public URL 但由 HTTPS 反代暴露时，可显式设为 true。
CYCLEDOCK_SECURE_COOKIE=

# Built-in Cycle Agent secret values。Settings 页面只保存下面这些变量的“名称”，
# 不会把 secret 明文写进 PostgreSQL。
CYCLEDOCK_MODEL_API_KEY=
CYCLEDOCK_MCP_TOKEN=

# ChatGPT / Grok 订阅账号凭据使用该 32-byte base64 key 做 AES-256-GCM 加密后写入 PostgreSQL。
# 例如：openssl rand -base64 32。启用订阅账号登录前必须设置，并应纳入部署 secret 备份。
CYCLEDOCK_MODEL_SECRET_KEY=

# Hosted / 远程部署使用 ChatGPT Plan 时填写 OpenAI 批准的 Sign in with ChatGPT client ID。
# 本机 loopback Self-hosted 开发可以使用 OpenAI 的 dynamic_agent_client 流程而留空。
CYCLEDOCK_CHATGPT_CLIENT_ID=

# 临时测试逃生口，默认必须保持 false/留空。
# 仅用于少量用户的受控 Hosted DEV，在尚未取得正式 Client ID 时验证 ChatGPT Plan 流程。
# 正式 Hosted/生产不得依赖此开关；取得 CYCLEDOCK_CHATGPT_CLIENT_ID 后必须删除/关闭。
CYCLEDOCK_CHATGPT_ALLOW_HOSTED_DYNAMIC_REGISTRATION=
